<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme" version="1" map-background="#172536" map-background-outside="#172536">
  <!-- PhoneBridge Dark V2: quiet dark-vector hierarchy based on the supplied reference video. -->
  <rule e="way" k="natural" v="water"><area fill="#123B50"/></rule>
  <rule e="way" k="waterway" v="river|canal|stream"><line stroke="#24506A" stroke-width="1.5"/></rule>
  <rule e="way" k="landuse" v="forest|grass|meadow|recreation_ground|village_green"><area fill="#173B3B"/></rule>
  <rule e="way" k="leisure" v="park|garden|golf_course"><area fill="#17413F"/></rule>
  <rule e="way" k="landuse" v="residential|commercial|retail|industrial"><area fill="#1B2A3A"/></rule>
  <rule e="way" k="building" v="*" zoom-min="16"><area fill="#223244" stroke="#2B4054" stroke-width="0.35"/></rule>

  <!-- Zoom-adaptive road hierarchy. Each zoom band has its own width. -->
  <rule e="way" k="highway" v="motorway|motorway_link" zoom-max="8"><line stroke="#B56A67" stroke-width="1.4" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-max="8"><line stroke="#98776A" stroke-width="0.8" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="9" zoom-max="10"><line stroke="#B56A67" stroke-width="2.2" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="9" zoom-max="10"><line stroke="#98776A" stroke-width="1.3" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="11" zoom-max="12"><line stroke="#0D1722" stroke-width="3.4" stroke-linecap="round"/><line stroke="#B56A67" stroke-width="2.4" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="11" zoom-max="12"><line stroke="#0D1722" stroke-width="3.0" stroke-linecap="round"/><line stroke="#98776A" stroke-width="2.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="11" zoom-max="12"><line stroke="#55738C" stroke-width="1.0" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="13" zoom-max="14"><line stroke="#0D1722" stroke-width="5.0" stroke-linecap="round"/><line stroke="#B56A67" stroke-width="3.5" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="13" zoom-max="14"><line stroke="#0D1722" stroke-width="4.0" stroke-linecap="round"/><line stroke="#98776A" stroke-width="2.8" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="13" zoom-max="14"><line stroke="#55738C" stroke-width="2.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="13" zoom-max="14"><line stroke="#405E76" stroke-width="1.0" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="15" zoom-max="16"><line stroke="#0D1722" stroke-width="6.0" stroke-linecap="round"/><line stroke="#B56A67" stroke-width="4.2" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="15" zoom-max="16"><line stroke="#0D1722" stroke-width="5.2" stroke-linecap="round"/><line stroke="#98776A" stroke-width="3.6" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="15" zoom-max="16"><line stroke="#55738C" stroke-width="2.8" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="15" zoom-max="16"><line stroke="#405E76" stroke-width="2.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="residential|unclassified|living_street" zoom-min="15" zoom-max="16"><line stroke="#31495E" stroke-width="1.0" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="17"><line stroke="#0D1722" stroke-width="7.0" stroke-linecap="round"/><line stroke="#B56A67" stroke-width="5.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="17"><line stroke="#0D1722" stroke-width="6.2" stroke-linecap="round"/><line stroke="#98776A" stroke-width="4.4" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="17"><line stroke="#55738C" stroke-width="3.8" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="17"><line stroke="#405E76" stroke-width="3.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="residential|unclassified|living_street" zoom-min="17"><line stroke="#31495E" stroke-width="2.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="service" zoom-min="17"><line stroke="#2A4054" stroke-width="1.2" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="track|path|footway|cycleway" zoom-min="18"><line stroke="#294054" stroke-width="0.8" stroke-linecap="round"/></rule>
  <rule e="way" k="railway" v="rail" zoom-min="13"><line stroke="#3D5061" stroke-width="0.9"/></rule>

  <!-- Label hierarchy: city/locality first, road names only as the view gets closer. -->
  <rule e="node" k="place" v="city" zoom-min="5"><caption k="name" font-size="18" fill="#E7EEF5" stroke="#172536" stroke-width="2.5"/></rule>
  <rule e="node" k="place" v="town" zoom-min="9"><caption k="name" font-size="15" fill="#D7E0E8" stroke="#172536" stroke-width="2.2"/></rule>
  <rule e="node" k="place" v="suburb" zoom-min="12"><caption k="name" font-size="13" fill="#BECAD5" stroke="#172536" stroke-width="2"/></rule>
  <rule e="node" k="place" v="village" zoom-min="13"><caption k="name" font-size="12" fill="#B4C1CC" stroke="#172536" stroke-width="2"/></rule>
  <rule e="node" k="place" v="neighbourhood|quarter" zoom-min="15"><caption k="name" font-size="11" fill="#AAB7C3" stroke="#172536" stroke-width="2"/></rule>

  <!-- At city scale only motorway/trunk names. Primary names arrive closer; ordinary streets much later. -->

  <!-- Useful landmarks only; routine POIs are deliberately delayed until street-level zoom. -->
  <rule e="node" k="tourism" v="attraction|museum" zoom-min="14"><caption k="name" font-size="10" fill="#BFCBD5" stroke="#172536" stroke-width="2"/></rule>
  <rule e="node" k="amenity" v="hospital|university|college" zoom-min="14"><caption k="name" font-size="10" fill="#BFCBD5" stroke="#172536" stroke-width="2"/></rule>
  <rule e="node" k="amenity" v="school|police|place_of_worship" zoom-min="16"><caption k="name" font-size="9" fill="#AEBBC7" stroke="#172536" stroke-width="2"/></rule>
  <rule e="node" k="amenity" v="restaurant|cafe|fast_food|pharmacy|bank|atm|fuel" zoom-min="18"><caption k="name" font-size="9" fill="#A5B2BE" stroke="#172536" stroke-width="2"/></rule>
  <rule e="node" k="shop" v="*" zoom-min="18"><caption k="name" font-size="9" fill="#9EACB8" stroke="#172536" stroke-width="2"/></rule>
</rendertheme>