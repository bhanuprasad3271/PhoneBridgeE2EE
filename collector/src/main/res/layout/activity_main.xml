<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical" android:padding="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView
            android:text="PhoneBridge Collector" android:textSize="24sp"
            android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView
            android:layout_marginTop="12dp"
            android:text="This app visibly syncs call-log records and notification previews you explicitly allow."
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/pairBundle"
            android:hint="Paste pairing bundle from Phone 1"
            android:minLines="4"
            android:inputType="textMultiLine"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnPair" android:text="Pair this phone"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnNotif" android:text="Open Notification Access"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnCalls" android:text="Grant Call Log Permission"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnSync" android:text="Sync Call Logs Now"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/status" android:text="Not paired"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
