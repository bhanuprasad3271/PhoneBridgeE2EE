<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0F172A" android:padding="14dp" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/btnTimelineBack" android:layout_width="48dp" android:layout_height="44dp"
            android:text="‹" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#334155"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingStart="12dp" android:text="Location Timeline" android:textColor="#F8FAFC"
            android:textSize="21sp" android:textStyle="bold"/>
        <Button android:id="@+id/btnTimelineTheme" android:layout_width="52dp" android:layout_height="44dp"
            android:text="☀" android:textSize="18sp" android:textColor="#FFFFFF" android:backgroundTint="#334155"/>
        <Button android:id="@+id/btnImportOfflineMap" android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="Map file" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#334155"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/btnTimelinePrevious" android:layout_width="52dp" android:layout_height="44dp"
            android:text="‹" android:textColor="#FFFFFF" android:backgroundTint="#334155"/>
        <Button android:id="@+id/btnTimelineDate" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:text="Today" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#475569"/>
        <Button android:id="@+id/btnTimelineNext" android:layout_width="52dp" android:layout_height="44dp"
            android:text="›" android:textColor="#FFFFFF" android:backgroundTint="#334155"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/timelineSummary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="#94A3B8" android:textSize="13sp"/>
    <Button android:id="@+id/btnTimelineStays" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_marginStart="8dp" android:text="Stays" android:textAllCaps="false"
        android:textColor="#422006" android:backgroundTint="#FBBF24" android:visibility="gone"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/timelineMapContainer"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="#0F172A">
        <org.mapsforge.map.android.view.MapView android:id="@+id/timelineMapView"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
        <TextView android:id="@+id/timelineMapStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="18dp"
            android:text="Offline map file not selected" android:textColor="#F8FAFC" android:textSize="15sp"
            android:background="#CC0F172A"/>
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:gravity="center"
        android:text="Offline map · local location overlay · no map API"
        android:textColor="#64748B" android:textSize="12sp"/>
</LinearLayout>
