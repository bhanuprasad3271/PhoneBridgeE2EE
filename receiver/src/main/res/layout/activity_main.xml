<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:id="@+id/pairingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:background="#0F172A">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PhoneBridge"
            android:textColor="#F8FAFC"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Connect Phone 2"
            android:textColor="#CBD5E1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Generate a code here, then enter it on Phone 2. The code stays visible until pairing succeeds."
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pairCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:letterSpacing="0.18"
            android:text="------"
            android:textColor="#60A5FA"
            android:textIsSelectable="true"
            android:textSize="44sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCreatePair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:backgroundTint="#2563EB"
            android:text="Generate 6-digit code"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Not connected"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#0F172A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="10dp"
            android:background="#111827">

            <TextView
                android:id="@+id/profileIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#2563EB"
                android:gravity="center"
                android:text="BP"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PhoneBridge"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dashboardStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connected"
                    android:textColor="#86EFAC"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAlertsTab"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:minWidth="0dp"
                android:backgroundTint="@android:color/transparent"
                android:text="🔔"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnMenu"
                android:layout_width="50dp"
                android:layout_height="52dp"
                android:minWidth="0dp"
                android:backgroundTint="@android:color/transparent"
                android:text="⋮"
                android:textColor="#F8FAFC"
                android:textSize="28sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tabScroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <Button
                    android:id="@+id/btnMessagesTab"
                    android:layout_width="132dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tab_selector"
                    android:backgroundTint="@null"
                    android:text="Messages"
                    android:textColor="#F8FAFC"
                    android:textAllCaps="false"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCallsTab"
                    android:layout_width="112dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tab_selector"
                    android:backgroundTint="@null"
                    android:text="Calls"
                    android:textColor="#F8FAFC"
                    android:textAllCaps="false"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnNotificationsTab"
                    android:layout_width="150dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tab_selector"
                    android:backgroundTint="@null"
                    android:text="Notifications"
                    android:textColor="#F8FAFC"
                    android:textAllCaps="false"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnWpCallsTab"
                    android:layout_width="126dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_tab_selector"
                    android:backgroundTint="@null"
                    android:text="WP Calls"
                    android:textColor="#F8FAFC"
                    android:textAllCaps="false"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/alertsToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="#451A1A"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sender alerts and device status"
                    android:textColor="#FCA5A5"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClearAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#7F1D1D"
                    android:text="Clear all"
                    android:textColor="#FEE2E2"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/listTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:text="Messages"
                    android:textColor="#F8FAFC"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:backgroundTint="#334155"
                    android:text="Filter"
                    android:textAllCaps="false"
                    android:textColor="#F8FAFC"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
