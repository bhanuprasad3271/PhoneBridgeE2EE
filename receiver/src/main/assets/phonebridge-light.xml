<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme" version="1" map-background="#F3F5F7" map-background-outside="#F3F5F7">
  <!-- PhoneBridge Dark V2: quiet dark-vector hierarchy based on the supplied reference video. -->
  <rule e="way" k="natural" v="water"><area fill="#CFE8F3"/></rule>
  <rule e="way" k="waterway" v="river|canal|stream"><line stroke="#A7CEDF" stroke-width="1.5"/></rule>
  <rule e="way" k="landuse" v="forest|grass|meadow|recreation_ground|village_green"><area fill="#DCEBDD"/></rule>
  <rule e="way" k="leisure" v="park|garden|golf_course"><area fill="#D5E8D7"/></rule>
  <rule e="way" k="landuse" v="residential|commercial|retail|industrial"><area fill="#ECEFF1"/></rule>
  <rule e="way" k="building" v="*" zoom-min="16"><area fill="#E2E5E8" stroke="#D1D6DA" stroke-width="0.35"/></rule>

  <!-- Zoom-adaptive road hierarchy. Each zoom band has its own width. -->
  <rule e="way" k="highway" v="motorway|motorway_link" zoom-max="8"><line stroke="#D68A83" stroke-width="1.4" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-max="8"><line stroke="#C9A37D" stroke-width="0.8" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="9" zoom-max="10"><line stroke="#D68A83" stroke-width="2.2" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="9" zoom-max="10"><line stroke="#C9A37D" stroke-width="1.3" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="11" zoom-max="12"><line stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round"/><line stroke="#D68A83" stroke-width="2.4" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="11" zoom-max="12"><line stroke="#FFFFFF" stroke-width="3.0" stroke-linecap="round"/><line stroke="#C9A37D" stroke-width="2.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="11" zoom-max="12"><line stroke="#AAB8C4" stroke-width="1.0" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="13" zoom-max="14"><line stroke="#FFFFFF" stroke-width="5.0" stroke-linecap="round"/><line stroke="#D68A83" stroke-width="3.5" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="13" zoom-max="14"><line stroke="#FFFFFF" stroke-width="4.0" stroke-linecap="round"/><line stroke="#C9A37D" stroke-width="2.8" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="13" zoom-max="14"><line stroke="#AAB8C4" stroke-width="2.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="13" zoom-max="14"><line stroke="#B5C0C9" stroke-width="1.0" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="15" zoom-max="16"><line stroke="#FFFFFF" stroke-width="6.0" stroke-linecap="round"/><line stroke="#D68A83" stroke-width="4.2" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="15" zoom-max="16"><line stroke="#FFFFFF" stroke-width="5.2" stroke-linecap="round"/><line stroke="#C9A37D" stroke-width="3.6" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="15" zoom-max="16"><line stroke="#AAB8C4" stroke-width="2.8" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="15" zoom-max="16"><line stroke="#B5C0C9" stroke-width="2.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="residential|unclassified|living_street" zoom-min="15" zoom-max="16"><line stroke="#C6CDD3" stroke-width="1.0" stroke-linecap="round"/></rule>

  <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="17"><line stroke="#FFFFFF" stroke-width="7.0" stroke-linecap="round"/><line stroke="#D68A83" stroke-width="5.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="trunk|trunk_link|primary|primary_link" zoom-min="17"><line stroke="#FFFFFF" stroke-width="6.2" stroke-linecap="round"/><line stroke="#C9A37D" stroke-width="4.4" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="17"><line stroke="#AAB8C4" stroke-width="3.8" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="17"><line stroke="#B5C0C9" stroke-width="3.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="residential|unclassified|living_street" zoom-min="17"><line stroke="#C6CDD3" stroke-width="2.0" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="service" zoom-min="17"><line stroke="#D0D5D9" stroke-width="1.2" stroke-linecap="round"/></rule>
  <rule e="way" k="highway" v="track|path|footway|cycleway" zoom-min="18"><line stroke="#D5D9DC" stroke-width="0.8" stroke-linecap="round"/></rule>
  <rule e="way" k="railway" v="rail" zoom-min="13"><line stroke="#AAB1B7" stroke-width="0.9"/></rule>

  <!-- Label hierarchy: city/locality first, road names only as the view gets closer. -->
  <rule e="node" k="place" v="city" zoom-min="5"><caption k="name" font-size="18" fill="#27313A" stroke="#F3F5F7" stroke-width="2.5"/></rule>
  <rule e="node" k="place" v="town" zoom-min="9"><caption k="name" font-size="15" fill="#34404A" stroke="#F3F5F7" stroke-width="2.2"/></rule>
  <rule e="node" k="place" v="suburb" zoom-min="12"><caption k="name" font-size="13" fill="#48545E" stroke="#F3F5F7" stroke-width="2"/></rule>
  <rule e="node" k="place" v="village" zoom-min="13"><caption k="name" font-size="12" fill="#53606A" stroke="#F3F5F7" stroke-width="2"/></rule>
  <rule e="node" k="place" v="neighbourhood|quarter" zoom-min="15"><caption k="name" font-size="11" fill="#5E6A74" stroke="#F3F5F7" stroke-width="2"/></rule>

  <!-- At city scale only motorway/trunk names. Primary names arrive closer; ordinary streets much later. -->

  <!-- POIs: hospitals are ordinary POIs. Keep all routine POIs at street-level only.
       Mapsforge collision handling suppresses overlapping captions so dense groups do not all render. -->
  <rule e="node" k="tourism" v="attraction|museum" zoom-min="17"><caption k="name" font-size="9" fill="#596670" stroke="#F3F5F7" stroke-width="2"/></rule>
  <rule e="node" k="amenity" v="hospital|university|college|school|police|place_of_worship|restaurant|cafe|fast_food|pharmacy|bank|atm|fuel" zoom-min="18"><caption k="name" font-size="9" fill="#64717B" stroke="#F3F5F7" stroke-width="2"/></rule>
  <rule e="node" k="shop" v="*" zoom-min="18"><caption k="name" font-size="9" fill="#6A7680" stroke="#F3F5F7" stroke-width="2"/></rule>
</rendertheme>